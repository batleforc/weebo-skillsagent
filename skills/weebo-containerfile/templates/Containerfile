# source: batlehub@20879e5 (Containerfile), trimmed.
# ── Build stage ───────────────────────────────────────────────────────────────
# Pin every base by tag AND digest; updatecli moves both (see .updatecli/).
FROM rust:1.98-slim-bookworm@sha256:ebd900bae66fd508b466cef82d64a83a5fb34682e4c8b2797a42908bddc95a57 AS chef

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libssl-dev make pkg-config \
    && rm -rf /var/lib/apt/lists/*

# cargo-chef builds the dependency layer from a recipe instead of hand-written
# stub crates. Pinned like the bases; bump it with the Rust image.
RUN cargo install --locked cargo-chef@0.1.78

WORKDIR /build

# ── Planner: workspace manifests → recipe.json ────────────────────────────────
# The recipe drops the workspace version, so a release bump does not invalidate
# the dependency layer, and every member is picked up without a COPY line each.
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY server/ server/
RUN cargo chef prepare --recipe-path recipe.json

# ── Builder: dependencies (cached while recipe.json is unchanged), then sources ─
FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json
# --locked: build exactly what Cargo.lock resolves and fail if it would need
# updating — the image must not resolve a dependency the repository never saw.
RUN cargo chef cook --locked --release -p my-server --recipe-path recipe.json

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY server/ server/
RUN cargo build --locked --release -p my-server

# Pre-create runtime directories so they can be copied into the shell-less distroless image.
RUN mkdir -p /var/cache/my-server

# ── Frontend build stage ───────────────────────────────────────────────────────
FROM node:26-slim@sha256:14bf3eac4bf209d906d3c41256597d3ab1f926b2e93a79e9bdfe1efd32454239 AS ui-builder

WORKDIR /ui
# Corepack is no longer distributed with Node (removed in Node 25), so pnpm is
# installed explicitly. Keep this version in sync with the `packageManager`
# field in ui/package.json. --ignore-scripts states the policy so a future
# pnpm release that adds an install-time script cannot run it here.
RUN npm install -g --ignore-scripts pnpm@11.26.0
# Manifests first, so `pnpm install` stays cached until the lockfile changes.
COPY ui/package.json ui/pnpm-lock.yaml ui/pnpm-workspace.yaml ./
# --frozen-lockfile is the `npm ci` equivalent: it fails rather than silently
# resolving something the committed lockfile does not describe.
RUN pnpm install --frozen-lockfile

COPY ui/ ./

# Generate the OpenAPI spec from the just-built binary and then the TS client
# (weebo-api-contract). Known debt (TD-0003 §4): this makes the UI stage wait
# for the whole Rust build; building from the committed spec would not.
COPY --from=builder /build/target/release/my-server /usr/local/bin/my-server
COPY config.example.toml /etc/my-server/config.toml
RUN my-server --config /etc/my-server/config.toml dump-spec > openapi.json && \
    pnpm run generate && \
    pnpm run build

# ── Runtime image ─────────────────────────────────────────────────────────────
FROM gcr.io/distroless/cc-debian12:latest@sha256:e5d81ddde149641e2a9ba55be4545bc125c67de07508b03ba4c22e6eb0ded5aa AS runtime

COPY --from=builder /build/target/release/my-server /usr/local/bin/my-server
# The cache directory is the one path the process writes to, so it must be
# owned by the runtime user. Everything else (the binary, the SPA bundle)
# stays root-owned and read-only to that user, which is what we want.
COPY --from=builder --chown=65532:65532 /var/cache/my-server /var/cache/my-server
COPY --from=ui-builder /ui/dist /app/ui/dist

EXPOSE 8080

# 65532 is distroless's `nonroot` user. Declared numerically because the image
# ships no shell and no /etc/passwd lookup is guaranteed at runtime; Kubernetes
# also needs a numeric UID to satisfy `runAsNonRoot` without resolving names.
# The chart pins the same UID in its podSecurityContext — keep the two in sync.
USER 65532:65532

ENTRYPOINT ["my-server"]
CMD ["--config", "/etc/my-server/config.toml"]
